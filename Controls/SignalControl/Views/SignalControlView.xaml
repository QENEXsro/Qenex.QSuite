<UserControl x:Class="Qenex.QSuite.Controls.SignalControl.Views.SignalControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Qenex.QSuite.Controls.SignalControl.Views"
             xmlns:conv="clr-namespace:Qenex.QSuite.Controls.SignalControl.Converters"
             xmlns:vm="clr-namespace:Qenex.QSuite.Controls.SignalControl.ViewModels"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:q="clr-namespace:Qenex.QSuite.Controls.OverridenWinControls;assembly=Qenex.QSuite.Controls.OverridenWinControls"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="100"
             d:DataContext="{d:DesignInstance vm:SignalControlViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent">
	
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Qenex.QSuite.Controls.Control;component/Style/SharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
			<BooleanToVisibilityConverter x:Key="TrueToVisible"/>
			<conv:TrueToCollapsedConverter x:Key="TrueToCollapsed"/>
			<conv:EditStateToBackgroundConverter x:Key="EditStateBackground"/>
			<conv:ErrorToBackgroundConverter x:Key="ErrorBackground"/>
			<!-- Header buttons (Read, Write): telerik:RadButton based on the theme style like every
			     other button in the controls (text color = Windows11 palette, switches with the theme),
			     with its own 20 px template copied from the settings arrow
			     (SquareExpanderStyle.HeaderButtonStyle in SharedStyles) so the theme template cannot
			     change its height -->
			<Style x:Key="HeaderButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
				<Setter Property="Height" Value="20"/>
				<Setter Property="MinHeight" Value="0"/>
				<Setter Property="MinWidth" Value="0"/>
				<Setter Property="Padding" Value="6,0"/>
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="VerticalAlignment" Value="Top"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="telerik:RadButton">
							<Border x:Name="ButtonBorder"
							        Background="{TemplateBinding Background}"
							        BorderBrush="#888"
							        BorderThickness="1"
							        CornerRadius="2"
							        Padding="{TemplateBinding Padding}"
							        SnapsToDevicePixels="True">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="ButtonBorder" Property="Background" Value="#22888888"/>
								</Trigger>
								<Trigger Property="IsPressed" Value="True">
									<Setter TargetName="ButtonBorder" Property="Background" Value="#44888888"/>
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter Property="Opacity" Value="0.4"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>

	<telerik:RadContextMenu.ContextMenu>
		<telerik:RadContextMenu>
			<telerik:RadMenuItem Header="Lock" IsCheckable="True" IsChecked="{Binding IsLocked, Mode=TwoWay}"/>
			<telerik:RadMenuItem Header="Write Mode" IsCheckable="True" IsChecked="{Binding IsWriteMode, Mode=TwoWay}"
			                     IsEnabled="{Binding CanWrite}"/>
			<!-- Same option as in the Matrix control: Enter writes immediately; unticked, the edit
			     stays pending and the Write button in the header sends it -->
			<telerik:RadMenuItem Header="Write on Enter" IsCheckable="True" IsChecked="{Binding WriteOnEnter, Mode=TwoWay}"
			                     IsEnabled="{Binding IsWriteActive}"/>
			<!-- Read on request is the button in the header only (same as WatchTable/Matrix) -->
		</telerik:RadContextMenu>
	</telerik:RadContextMenu.ContextMenu>
    
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>	
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<telerik:RadExpander Grid.Row="0" Grid.Column="0" Style="{StaticResource SquareExpanderStyle}" HorizontalAlignment="Left">
			<Grid Margin="5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				
				<q:QTextBlock Grid.Column="0" Grid.Row="0" Text="Refresh [ms]:" Margin="0,3,0,0" HorizontalAlignment="Left"/>
				<q:QTextBox Grid.Column="1" Grid.Row="0" Text="{Binding RefreshTime, Mode=TwoWay}"
				            Margin="8,3,0,0" HorizontalAlignment="Left" Height="20" Width="50" VerticalAlignment="Center"
				            ToolTip="Refresh period of the displayed value"/>

				<q:QTextBlock Grid.Column="0" Grid.Row="1" Text="Peak threshold [%]:" Margin="0,3,0,0" HorizontalAlignment="Left"/>
				<q:QTextBox Grid.Column="1" Grid.Row="1" Text="{Binding PeakThresholdPercentage, Mode=TwoWay}"
				            Margin="8,3,0,0" HorizontalAlignment="Left" Height="20" Width="50" VerticalAlignment="Center"
				            ToolTip="Value change (in % of the presentation Min-Max range) shown immediately, without waiting for the refresh period; 0 = every change is shown immediately"/>
				
			</Grid>
		</telerik:RadExpander>
		
		<!-- Read on request: next to the settings arrow, exactly the arrow button's size (20 px high);
		     shown only for a variable bound to an On Request event -->
		<!-- Margin top 1 = the expander header's 1 px border above the arrow button, so both
		     20 px boxes share the same top edge (measured with _Tests/LayoutProbe: delta 0) -->
		<telerik:RadButton Grid.Row="0" Grid.Column="1" Content="Read" Command="{Binding ReadCommand}"
		                   Style="{StaticResource HeaderButtonStyle}" Margin="3,1,0,0"
		                   Background="{Binding IsReadError, Converter={StaticResource ErrorBackground}}"
		                   IsEnabled="{Binding CanReadNow}"
		                   Visibility="{Binding CanRead, Converter={StaticResource TrueToVisible}}"
		                   ToolTip="Read the value from the device once (On Request event)"/>

		<!-- Write button (same as the Matrix control): only in write mode with Write on Enter off;
		     enabled once the value is edited, greys back after the write -->
		<telerik:RadButton Grid.Row="0" Grid.Column="2" Content="Write" Command="{Binding WriteDirtyCommand}"
		                   Style="{StaticResource HeaderButtonStyle}" Margin="3,1,0,0"
		                   Background="{Binding IsWriteError, Converter={StaticResource ErrorBackground}}"
		                   IsEnabled="{Binding CanWriteDirty}"
		                   Visibility="{Binding IsWriteButtonVisible, Converter={StaticResource TrueToVisible}}"
		                   ToolTip="Write the edited value to the device"/>

		<q:QTextBlock Grid.Row="0" Grid.Column="3" Text="{Binding VariableLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
		              Margin="5,0,0,3" TextWrapping="NoWrap" HorizontalAlignment="Left"/>

		<StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Vertical" Margin="0,3,0,0">
			
			<Grid HorizontalAlignment="Stretch">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>	
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>	
				
				<!-- Zadny lokalni Style: prebil by implicitni theme styl QTextBoxu
				     registrovany v ShellWindow.Resources (barvy tematu) -->
				<q:QTextBox Grid.Column="0" Text="{Binding VariableValue, Mode=TwoWay, UpdateSourceTrigger=Default}"
				            MinWidth="50" IsReadOnly="True" TextAlignment="Right" HorizontalAlignment="Stretch"
				            Background="{Binding IsReadError, Converter={StaticResource ErrorBackground}}"
				            Visibility="{Binding IsWriteActive, Converter={StaticResource TrueToCollapsed}}"/>

				<!-- Edit box: orange in write mode (editable, whatever Write on Enter), yellow while
				     the edited value is pending, red after a failed write -->
				<q:QTextBox Grid.Column="0" Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				            MinWidth="50" TextAlignment="Right" HorizontalAlignment="Stretch"
				            Visibility="{Binding IsWriteActive, Converter={StaticResource TrueToVisible}}"
				            ToolTip="Engineering value; Enter writes it (Write on Enter) or the Write button sends it">
					<q:QTextBox.Background>
						<MultiBinding Converter="{StaticResource EditStateBackground}">
							<Binding Path="IsWriteActive"/>
							<Binding Path="IsDirty"/>
							<Binding Path="IsWriteError"/>
						</MultiBinding>
					</q:QTextBox.Background>
					<q:QTextBox.InputBindings>
						<KeyBinding Key="Enter" Command="{Binding WriteValueCommand}"/>
					</q:QTextBox.InputBindings>
				</q:QTextBox>

				<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5,0,0,0">
					<q:QTextBlock Text="[" Margin="0,0,3,0"/>
					<q:QTextBlock Text="{Binding VariableUnit, Mode=TwoWay, UpdateSourceTrigger=Default}"/>
					<q:QTextBlock Text="]" Margin="3,0,0,0"/>
				</StackPanel>
			</Grid>
		</StackPanel>
		
	</Grid>
</UserControl>
