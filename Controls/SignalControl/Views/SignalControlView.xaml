<UserControl x:Class="Qenex.QSuite.Controls.SignalControl.Views.SignalControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Qenex.QSuite.Controls.SignalControl.Views"
             xmlns:conv="clr-namespace:Qenex.QSuite.Controls.SignalControl.Converters"
             xmlns:vm="clr-namespace:Qenex.QSuite.Controls.SignalControl.ViewModels"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:q="clr-namespace:Qenex.QSuite.Controls.OverridenWinControls;assembly=Qenex.QSuite.Controls.OverridenWinControls"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="100"
             d:DataContext="{d:DesignInstance vm:SignalControlViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent">
	
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Qenex.QSuite.Controls.Control;component/Style/SharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
			<BooleanToVisibilityConverter x:Key="TrueToVisible"/>
			<conv:TrueToCollapsedConverter x:Key="TrueToCollapsed"/>
			<conv:WriteErrorToBackgroundConverter x:Key="WriteErrorBackground"/>
			<conv:ReadErrorToBackgroundConverter x:Key="ReadErrorBackground"/>
			<!-- Read button drawn exactly like the settings arrow button of SquareExpanderStyle
			     (20 px high box, #888 1 px border, radius 2, transparent) - own template so no
			     theme style can change its height -->
			<Style x:Key="ReadButtonStyle" TargetType="Button">
				<Setter Property="Height" Value="20"/>
				<Setter Property="MinHeight" Value="0"/>
				<Setter Property="MinWidth" Value="0"/>
				<Setter Property="Padding" Value="6,0"/>
				<!-- Foreground not set: the caption inherits the theme text color like the label -->
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="VerticalAlignment" Value="Top"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border x:Name="ButtonBorder"
							        Background="{TemplateBinding Background}"
							        BorderBrush="#888"
							        BorderThickness="1"
							        CornerRadius="2"
							        Padding="{TemplateBinding Padding}"
							        SnapsToDevicePixels="True">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="ButtonBorder" Property="Background" Value="#22888888"/>
								</Trigger>
								<Trigger Property="IsPressed" Value="True">
									<Setter TargetName="ButtonBorder" Property="Background" Value="#44888888"/>
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter Property="Opacity" Value="0.4"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>

	<telerik:RadContextMenu.ContextMenu>
		<telerik:RadContextMenu>
			<telerik:RadMenuItem Header="Lock" IsCheckable="True" IsChecked="{Binding IsLocked, Mode=TwoWay}"/>
			<telerik:RadMenuItem Header="Write Mode" IsCheckable="True" IsChecked="{Binding IsWriteMode, Mode=TwoWay}"
			                     IsEnabled="{Binding CanWrite}"/>
			<!-- Read on request: enabled only for a variable bound to an On Request event -->
			<telerik:RadMenuItem Header="Read" Command="{Binding ReadCommand}" IsEnabled="{Binding CanReadNow}"/>
		</telerik:RadContextMenu>
	</telerik:RadContextMenu.ContextMenu>
    
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>	
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<telerik:RadExpander Grid.Row="0" Grid.Column="0" Style="{StaticResource SquareExpanderStyle}" HorizontalAlignment="Left">
			<Grid Margin="5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				
				<q:QTextBlock Grid.Column="0" Grid.Row="0" Text="Refresh [ms]:" Margin="0,3,0,0" HorizontalAlignment="Left"/>
				<q:QTextBox Grid.Column="1" Grid.Row="0" Text="{Binding RefreshTime, Mode=TwoWay}"
				            Margin="8,3,0,0" HorizontalAlignment="Left" Height="20" Width="50" VerticalAlignment="Center"
				            ToolTip="Refresh period of the displayed value"/>

				<q:QTextBlock Grid.Column="0" Grid.Row="1" Text="Peak threshold [%]:" Margin="0,3,0,0" HorizontalAlignment="Left"/>
				<q:QTextBox Grid.Column="1" Grid.Row="1" Text="{Binding PeakThresholdPercentage, Mode=TwoWay}"
				            Margin="8,3,0,0" HorizontalAlignment="Left" Height="20" Width="50" VerticalAlignment="Center"
				            ToolTip="Value change (in % of the presentation Min-Max range) shown immediately, without waiting for the refresh period; 0 = every change is shown immediately"/>
				
			</Grid>
		</telerik:RadExpander>
		
		<!-- Read on request: next to the settings arrow, exactly the arrow button's size (20 px high);
		     shown only for a variable bound to an On Request event -->
		<!-- Margin top 1 = the expander header's 1 px border above the arrow button, so both
		     20 px boxes share the same top edge (measured with _Tests/LayoutProbe: delta 0) -->
		<Button Grid.Row="0" Grid.Column="1" Content="Read" Command="{Binding ReadCommand}"
		        Style="{StaticResource ReadButtonStyle}" Margin="3,1,0,0"
		        Background="{Binding IsReadError, Converter={StaticResource ReadErrorBackground}}"
		        IsEnabled="{Binding CanReadNow}"
		        Visibility="{Binding CanRead, Converter={StaticResource TrueToVisible}}"
		        ToolTip="Read the value from the device once (On Request event)"/>

		<q:QTextBlock Grid.Row="0" Grid.Column="2" Text="{Binding VariableLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
		              Margin="5,0,0,3" TextWrapping="NoWrap" HorizontalAlignment="Left"/>

		<StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Vertical" Margin="0,3,0,0">
			
			<Grid HorizontalAlignment="Stretch">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>	
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>	
				
				<!-- Zadny lokalni Style: prebil by implicitni theme styl QTextBoxu
				     registrovany v ShellWindow.Resources (barvy tematu) -->
				<q:QTextBox Grid.Column="0" Text="{Binding VariableValue, Mode=TwoWay, UpdateSourceTrigger=Default}"
				            MinWidth="50" IsReadOnly="True" TextAlignment="Right" HorizontalAlignment="Stretch"
				            Background="{Binding IsReadError, Converter={StaticResource ReadErrorBackground}}"
				            Visibility="{Binding IsWriteActive, Converter={StaticResource TrueToCollapsed}}"/>

				<q:QTextBox Grid.Column="0" Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				            MinWidth="50" TextAlignment="Right" HorizontalAlignment="Stretch"
				            Visibility="{Binding IsWriteActive, Converter={StaticResource TrueToVisible}}"
				            Background="{Binding IsWriteError, Converter={StaticResource WriteErrorBackground}}"
				            ToolTip="Engineering value; Enter writes it to the device">
					<q:QTextBox.InputBindings>
						<KeyBinding Key="Enter" Command="{Binding WriteValueCommand}"/>
					</q:QTextBox.InputBindings>
				</q:QTextBox>

				<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5,0,0,0">
					<q:QTextBlock Text="[" Margin="0,0,3,0"/>
					<q:QTextBlock Text="{Binding VariableUnit, Mode=TwoWay, UpdateSourceTrigger=Default}"/>
					<q:QTextBlock Text="]" Margin="3,0,0,0"/>
				</StackPanel>
			</Grid>
		</StackPanel>
		
	</Grid>
</UserControl>
