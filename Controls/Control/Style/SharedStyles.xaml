<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
	
	<Style TargetType="CheckBox"
	       BasedOn="{StaticResource CheckBoxStyle}">
		<Setter Property="Focusable" Value="False"/>
	</Style>
	
	<Style x:Key="SquareExpanderStyle" TargetType="telerik:RadExpander" 
           BasedOn="{StaticResource RadExpanderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="HeaderButtonStyle">
            <Setter.Value>
                <Style TargetType="telerik:RadToggleButton">
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="telerik:RadToggleButton">
                                <Border x:Name="ButtonBorder"
                                        Background="Transparent"
                                        BorderBrush="#888"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        SnapsToDevicePixels="True">
                                    <Path x:Name="arrow"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stroke="#999"
                                          StrokeThickness="1.5"
                                          Fill="Transparent"
                                          Data="M 0,0 L 4,5 L 8,0"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="arrow" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="arrow" Property="Stroke" Value="#CCC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
	<!-- Header buttons of the controls (Read, Write next to the settings arrow): telerik:RadButton
	     based on the theme style like every other button in the controls (text color = Windows11
	     palette, switches with the theme), with its own 20 px template copied from the settings
	     arrow (SquareExpanderStyle.HeaderButtonStyle above) so the theme template cannot change
	     its height. Used by Single-Signal and Matrix. -->
	<Style x:Key="HeaderButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
		<Setter Property="Height" Value="20"/>
		<Setter Property="MinHeight" Value="0"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="Padding" Value="6,0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="VerticalAlignment" Value="Top"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="telerik:RadButton">
					<Border x:Name="ButtonBorder"
					        Background="{TemplateBinding Background}"
					        BorderBrush="#888"
					        BorderThickness="1"
					        CornerRadius="2"
					        Padding="{TemplateBinding Padding}"
					        SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ButtonBorder" Property="Background" Value="#22888888"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="ButtonBorder" Property="Background" Value="#44888888"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.4"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
