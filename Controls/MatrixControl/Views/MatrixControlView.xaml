<UserControl x:Class="Qenex.QSuite.Controls.MatrixControl.Views.MatrixControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Qenex.QSuite.Controls.MatrixControl.Converters"
             xmlns:vm="clr-namespace:Qenex.QSuite.Controls.MatrixControl.ViewModels"
             xmlns:behaviors="clr-namespace:Qenex.QSuite.Controls.MatrixControl.Behaviors"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:q="clr-namespace:Qenex.QSuite.Controls.OverridenWinControls;assembly=Qenex.QSuite.Controls.OverridenWinControls"
             mc:Ignorable="d"
             d:DesignHeight="180" d:DesignWidth="320"
             d:DataContext="{d:DesignInstance vm:MatrixControlViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Qenex.QSuite.Controls.Control;component/Style/SharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
			<BooleanToVisibilityConverter x:Key="TrueToVisible"/>
			<conv:TrueToCollapsedConverter x:Key="TrueToCollapsed"/>
			<conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
			<conv:ErrorToBackgroundConverter x:Key="ErrorBackground"/>
			<conv:InverseBoolConverter x:Key="InverseBool"/>
			<conv:ColorToBrushConverter x:Key="ColorToBrush"/>

			<!-- Cell of the table. The grid columns bind the cell view model itself (row.Cells[i]),
			     so the templates reach it through the GridViewCell.Value of their cell. Display =
			     TextBlock inside the Telerik cell (text colour from the theme, as in WatchTable);
			     a text box exists only for the one cell being edited (CellEditTemplate). -->
			<DataTemplate x:Key="MatrixCellTemplate">
				<TextBlock Text="{Binding Value.DisplayText, RelativeSource={RelativeSource AncestorType=telerik:GridViewCell}}"
				           TextAlignment="Right" VerticalAlignment="Center"/>
			</DataTemplate>
			<!-- Zadny lokalni Style: prebil by implicitni theme styl QTextBoxu (barvy tematu). -->
			<DataTemplate x:Key="MatrixCellEditTemplate">
				<q:QTextBox Text="{Binding Value.EditText, RelativeSource={RelativeSource AncestorType=telerik:GridViewCell},
				                   Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				            TextAlignment="Right" VerticalAlignment="Center" BorderThickness="0" Padding="0" MinHeight="0"
				            FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
				            behaviors:MatrixGridBehavior.SelectAllOnFocus="True"
				            ToolTip="Engineering value; Enter writes it (Write on Enter) or the Write button sends it; Tab = next cell"/>
			</DataTemplate>
			<!-- Cell background from the view model (write error > dirty > read error > write mode >
			     colour scale > theme). No gaps between cells; the X axis row and the Y axis column
			     carry a separator line with a gap towards the data (Radek 2026-09-26).
			     Telerik lightweight ("core") templates of row and cell: 8 instead of 13 visuals per
			     cell, a quarter less time to show a 64x64 map (probe 2026-09-26). -->
			<Style x:Key="MatrixRowStyle" TargetType="telerik:GridViewRow" BasedOn="{StaticResource GridViewRowCoreStyle}"/>
			<Style x:Key="MatrixCellStyle" TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellCoreStyle}">
				<Setter Property="Padding" Value="3,1"/>
				<Setter Property="Background" Value="{Binding Value.Background, RelativeSource={RelativeSource Self}}"/>
				<Style.Triggers>
					<!-- Separator line between the axes and the data in the saved theme text colour
					     (ControlBase.ForegroundColor, set by the host for the dark / light theme) -->
					<DataTrigger Binding="{Binding Value.Kind, RelativeSource={RelativeSource Self}}" Value="XAxis">
						<Setter Property="BorderBrush" Value="{Binding DataContext.ForegroundColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrush}}"/>
						<Setter Property="BorderThickness" Value="0,0,0,1"/>
						<Setter Property="Padding" Value="3,1,3,4"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding Value.Kind, RelativeSource={RelativeSource Self}}" Value="YAxis">
						<Setter Property="BorderBrush" Value="{Binding DataContext.ForegroundColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrush}}"/>
						<Setter Property="BorderThickness" Value="0,0,1,0"/>
						<Setter Property="Padding" Value="3,1,6,1"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding Value.IsPlaceholder, RelativeSource={RelativeSource Self}}" Value="True">
						<Setter Property="BorderBrush" Value="{Binding DataContext.ForegroundColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrush}}"/>
						<Setter Property="BorderThickness" Value="0,0,1,1"/>
						<Setter Property="Padding" Value="3,1,6,4"/>
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>

	<telerik:RadContextMenu.ContextMenu>
		<telerik:RadContextMenu>
			<telerik:RadMenuItem Header="Lock" IsCheckable="True" IsChecked="{Binding IsLocked, Mode=TwoWay}"/>
			<telerik:RadMenuItem Header="Write Mode" IsCheckable="True" IsChecked="{Binding IsWriteMode, Mode=TwoWay}"
			                     IsEnabled="{Binding CanWrite}"/>
			<!-- Same option as in the Single-Signal and Watch Table controls: Enter writes immediately;
			     unticked, the edit stays pending and the Write button in the header sends it -->
			<telerik:RadMenuItem Header="Write on Enter" IsCheckable="True" IsChecked="{Binding WriteOnEnter, Mode=TwoWay}"
			                     IsEnabled="{Binding IsWriteActive}"/>
			<!-- Read on request is the button in the header only (same as Single-Signal/WatchTable);
			     "Auto Read" removed: the table always follows the device (poll / Read) -->
		</telerik:RadContextMenu>
	</telerik:RadContextMenu.ContextMenu>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Header: settings expander | Read | Write | variable label (same order as Single-Signal) -->
		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Settings in two column pairs (3 rows) so they fit a low control such as a curve
			     (the expander content is clipped by the control height, Radek 2026-09-26) -->
			<telerik:RadExpander Grid.Column="0" Style="{StaticResource SquareExpanderStyle}" HorizontalAlignment="Left">
				<Grid Margin="5">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<q:QTextBlock Grid.Column="0" Grid.Row="0" Text="Refresh [ms]:" Margin="0,3,0,0" HorizontalAlignment="Left"/>
					<q:QTextBox Grid.Column="1" Grid.Row="0" Text="{Binding RefreshTime, Mode=TwoWay}"
					            Margin="8,3,0,0" HorizontalAlignment="Left" Height="20" Width="50" VerticalAlignment="Center"/>

					<q:QTextBlock Grid.Column="0" Grid.Row="1" Text="Cell width [px]:" Margin="0,3,0,0" HorizontalAlignment="Left"/>
					<q:QTextBox Grid.Column="1" Grid.Row="1" Text="{Binding CellWidth, Mode=TwoWay}"
					            Margin="8,3,0,0" HorizontalAlignment="Left" Height="20" Width="50" VerticalAlignment="Center"/>

					<!-- Colour scale of the data cells: on/off, range and spectrum (persisted in the project).
					     CheckBox without the theme padding / min height (GraphControl pattern) so its box sits
					     on the text box line, not below and to the right of it. -->
					<q:QTextBlock Grid.Column="2" Grid.Row="0" Text="Color scale:" Margin="16,3,0,0" HorizontalAlignment="Left"/>
					<CheckBox Grid.Column="3" Grid.Row="0" IsChecked="{Binding IsHeatmapEnabled, Mode=TwoWay}"
					          Margin="8,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
					          MinHeight="0" MinWidth="0" Padding="0"
					          ToolTip="Tint the data cells by value between Min and Max"/>

					<q:QTextBlock Grid.Column="2" Grid.Row="1" Text="Min / Max:" Margin="16,3,0,0" HorizontalAlignment="Left"/>
					<StackPanel Grid.Column="3" Grid.Row="1" Orientation="Horizontal" Margin="8,3,0,0" HorizontalAlignment="Left">
						<q:QTextBox Text="{Binding HeatMinimum, Mode=TwoWay}" Height="20" Width="60" VerticalAlignment="Center"
						            IsEnabled="{Binding IsHeatmapEnabled}"/>
						<q:QTextBox Text="{Binding HeatMaximum, Mode=TwoWay}" Height="20" Width="60" Margin="4,0,0,0" VerticalAlignment="Center"
						            IsEnabled="{Binding IsHeatmapEnabled}"/>
					</StackPanel>

					<q:QTextBlock Grid.Column="2" Grid.Row="2" Text="Spectrum:" Margin="16,3,0,0" HorizontalAlignment="Left"/>
					<telerik:RadComboBox Grid.Column="3" Grid.Row="2" ItemsSource="{Binding Spectrums}"
					                     SelectedItem="{Binding HeatSpectrum, Mode=TwoWay}"
					                     Margin="8,3,0,0" HorizontalAlignment="Left" Width="124" Height="22" MinHeight="0" Padding="8,0"
					                     VerticalAlignment="Center" IsEnabled="{Binding IsHeatmapEnabled}"/>
				</Grid>
			</telerik:RadExpander>

			<!-- Read on request: next to the settings arrow, the arrow button's size (HeaderButtonStyle
			     in SharedStyles, 20 px); shown only for a matrix bound to an On Request event, red
			     after a failed read. Margin top 1 = the expander header's 1 px border above the arrow. -->
			<telerik:RadButton Grid.Column="1" Content="Read" Command="{Binding ReadCommand}"
			                   Style="{StaticResource HeaderButtonStyle}" Margin="3,1,0,0"
			                   Background="{Binding IsReadError, Converter={StaticResource ErrorBackground}}"
			                   IsEnabled="{Binding CanReadNow}"
			                   Visibility="{Binding CanRead, Converter={StaticResource TrueToVisible}}"
			                   ToolTip="Read the matrix from the device once (On Request event; discards pending edits)"/>

			<!-- Write button (same as Single-Signal): only in write mode with Write on Enter off;
			     enabled once some cell is edited, greys back after the write, red when a cell failed -->
			<telerik:RadButton Grid.Column="2" Content="Write" Command="{Binding WriteDirtyCommand}"
			                   Style="{StaticResource HeaderButtonStyle}" Margin="3,1,0,0"
			                   Background="{Binding HasWriteErrorCells, Converter={StaticResource ErrorBackground}}"
			                   IsEnabled="{Binding CanWriteDirty}"
			                   Visibility="{Binding IsWriteButtonVisible, Converter={StaticResource TrueToVisible}}"
			                   ToolTip="Write all edited (highlighted) cells to the device"/>

			<StackPanel Grid.Column="3" Orientation="Horizontal" Margin="5,0,0,3" VerticalAlignment="Center">
				<q:QTextBlock Text="{Binding VariableLabel}" TextWrapping="NoWrap"/>
				<q:QTextBlock Text=" ["/>
				<q:QTextBlock Text="{Binding DataUnit}"/>
				<q:QTextBlock Text="]"/>
			</StackPanel>
		</Grid>

		<!-- Matrix table: X axis as the first row, Y axis as the first column; axis captions from
		     the variable layout (X above, Y rotated on the left). Virtualised RadGridView (rows and
		     columns), one column per table column created by MatrixGridBehavior; scrollbars appear
		     when the map is larger than the control. -->
		<Grid Grid.Row="1" Margin="0,3,0,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<q:QTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding XAxisLabel}" FontStyle="Italic"
			              HorizontalAlignment="Center" Margin="0,0,0,2"
			              Visibility="{Binding XAxisLabel, Converter={StaticResource EmptyToCollapsed}}"/>

			<q:QTextBlock Grid.Row="1" Grid.Column="0" Text="{Binding YAxisLabel}" FontStyle="Italic"
			              VerticalAlignment="Center" Margin="0,0,2,0"
			              Visibility="{Binding YAxisLabel, Converter={StaticResource EmptyToCollapsed}}">
				<q:QTextBlock.LayoutTransform>
					<RotateTransform Angle="-90"/>
				</q:QTextBlock.LayoutTransform>
			</q:QTextBlock>

			<telerik:RadGridView Grid.Row="1" Grid.Column="1"
			                     behaviors:MatrixGridBehavior.CellTemplate="{StaticResource MatrixCellTemplate}"
			                     behaviors:MatrixGridBehavior.CellEditTemplate="{StaticResource MatrixCellEditTemplate}"
			                     behaviors:MatrixGridBehavior.CellStyle="{StaticResource MatrixCellStyle}"
			                     behaviors:MatrixGridBehavior.CellWidth="{Binding CellWidth}"
			                     behaviors:MatrixGridBehavior.ColumnCount="{Binding ColumnCount}"
			                     behaviors:MatrixGridBehavior.IsEnabled="True"
			                     ItemsSource="{Binding Rows}"
			                     RowStyle="{StaticResource MatrixRowStyle}"
			                     IsReadOnly="{Binding IsWriteActive, Converter={StaticResource InverseBool}}"
			                     AutoGenerateColumns="False"
			                     ShowColumnHeaders="False"
			                     ShowGroupPanel="False"
			                     RowIndicatorVisibility="Collapsed"
			                     SelectionUnit="Cell"
			                     SelectionMode="Extended"
			                     ClipboardCopyMode="Cells"
			                     ClipboardPasteMode="None"
			                     GroupRenderMode="Flat"
			                     EnableRowVirtualization="True"
			                     EnableColumnVirtualization="True"
			                     CanUserFreezeColumns="False"
			                     CanUserReorderColumns="False"
			                     CanUserResizeColumns="False"
			                     CanUserSortColumns="False"
			                     CanUserDeleteRows="False"
			                     CanUserInsertRows="False"
			                     IsFilteringAllowed="False"
			                     ValidatesOnDataErrors="None"
			                     RowHeight="20"
			                     GridLinesVisibility="Both"
			                     Background="Transparent"
			                     BorderThickness="0"/>
		</Grid>
	</Grid>
</UserControl>
