<UserControl x:Class="Qenex.QSuite.Controls.MatrixControl.Views.MatrixControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Qenex.QSuite.Controls.MatrixControl.Converters"
             xmlns:vm="clr-namespace:Qenex.QSuite.Controls.MatrixControl.ViewModels"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:q="clr-namespace:Qenex.QSuite.Controls.OverridenWinControls;assembly=Qenex.QSuite.Controls.OverridenWinControls"
             mc:Ignorable="d"
             d:DesignHeight="180" d:DesignWidth="320"
             d:DataContext="{d:DesignInstance vm:MatrixControlViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Qenex.QSuite.Controls.Control;component/Style/SharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
			<BooleanToVisibilityConverter x:Key="TrueToVisible"/>
			<conv:TrueToCollapsedConverter x:Key="TrueToCollapsed"/>
			<conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
			<conv:EditStateToBackgroundConverter x:Key="EditStateBackground"/>
			<conv:ErrorToBackgroundConverter x:Key="ErrorBackground"/>
		</ResourceDictionary>
	</UserControl.Resources>

	<telerik:RadContextMenu.ContextMenu>
		<telerik:RadContextMenu>
			<telerik:RadMenuItem Header="Lock" IsCheckable="True" IsChecked="{Binding IsLocked, Mode=TwoWay}"/>
			<telerik:RadMenuItem Header="Write Mode" IsCheckable="True" IsChecked="{Binding IsWriteMode, Mode=TwoWay}"
			                     IsEnabled="{Binding CanWrite}"/>
			<!-- Same option as in the Single-Signal and Watch Table controls: Enter writes immediately;
			     unticked, the edit stays pending and the Write button in the header sends it -->
			<telerik:RadMenuItem Header="Write on Enter" IsCheckable="True" IsChecked="{Binding WriteOnEnter, Mode=TwoWay}"
			                     IsEnabled="{Binding IsWriteActive}"/>
			<!-- Read on request is the button in the header only (same as Single-Signal/WatchTable);
			     "Auto Read" removed: the table always follows the device (poll / Read) -->
		</telerik:RadContextMenu>
	</telerik:RadContextMenu.ContextMenu>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Header: settings expander | Read | Write | variable label (same order as Single-Signal) -->
		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<telerik:RadExpander Grid.Column="0" Style="{StaticResource SquareExpanderStyle}" HorizontalAlignment="Left">
				<Grid Margin="5">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<q:QTextBlock Grid.Column="0" Grid.Row="0" Text="Refresh [ms]:" Margin="0,3,0,0" HorizontalAlignment="Left"/>
					<q:QTextBox Grid.Column="1" Grid.Row="0" Text="{Binding RefreshTime, Mode=TwoWay}"
					            Margin="8,3,0,0" HorizontalAlignment="Left" Height="20" Width="50" VerticalAlignment="Center"/>

					<q:QTextBlock Grid.Column="0" Grid.Row="1" Text="Cell width [px]:" Margin="0,3,0,0" HorizontalAlignment="Left"/>
					<q:QTextBox Grid.Column="1" Grid.Row="1" Text="{Binding CellWidth, Mode=TwoWay}"
					            Margin="8,3,0,0" HorizontalAlignment="Left" Height="20" Width="50" VerticalAlignment="Center"/>
				</Grid>
			</telerik:RadExpander>

			<!-- Read on request: next to the settings arrow, the arrow button's size (HeaderButtonStyle
			     in SharedStyles, 20 px); shown only for a matrix bound to an On Request event, red
			     after a failed read. Margin top 1 = the expander header's 1 px border above the arrow. -->
			<telerik:RadButton Grid.Column="1" Content="Read" Command="{Binding ReadCommand}"
			                   Style="{StaticResource HeaderButtonStyle}" Margin="3,1,0,0"
			                   Background="{Binding IsReadError, Converter={StaticResource ErrorBackground}}"
			                   IsEnabled="{Binding CanReadNow}"
			                   Visibility="{Binding CanRead, Converter={StaticResource TrueToVisible}}"
			                   ToolTip="Read the matrix from the device once (On Request event; discards pending edits)"/>

			<!-- Write button (same as Single-Signal): only in write mode with Write on Enter off;
			     enabled once some cell is edited, greys back after the write, red when a cell failed -->
			<telerik:RadButton Grid.Column="2" Content="Write" Command="{Binding WriteDirtyCommand}"
			                   Style="{StaticResource HeaderButtonStyle}" Margin="3,1,0,0"
			                   Background="{Binding HasWriteErrorCells, Converter={StaticResource ErrorBackground}}"
			                   IsEnabled="{Binding CanWriteDirty}"
			                   Visibility="{Binding IsWriteButtonVisible, Converter={StaticResource TrueToVisible}}"
			                   ToolTip="Write all edited (highlighted) cells to the device"/>

			<StackPanel Grid.Column="3" Orientation="Horizontal" Margin="5,0,0,3" VerticalAlignment="Center">
				<q:QTextBlock Text="{Binding VariableLabel}" TextWrapping="NoWrap"/>
				<q:QTextBlock Text=" ["/>
				<q:QTextBlock Text="{Binding DataUnit}"/>
				<q:QTextBlock Text="]"/>
			</StackPanel>
		</Grid>

		<!-- Matrix table: X axis as the first (header) row, Y axis as the first column;
		     axis captions from the variable layout (X above, Y rotated on the left).
		     Zadny ScrollViewer (rozhodnuti Radka): obsah se orizne, pohyb kurzorem
		     v editacnich polich jako u Comm params; velikost ridi resize controlu. -->
		<Grid Grid.Row="1" Margin="0,3,0,0" ClipToBounds="True">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<q:QTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding XAxisLabel}" FontStyle="Italic"
				              HorizontalAlignment="Center" Margin="0,0,0,2"
				              Visibility="{Binding XAxisLabel, Converter={StaticResource EmptyToCollapsed}}"/>

				<q:QTextBlock Grid.Row="1" Grid.Column="0" Text="{Binding YAxisLabel}" FontStyle="Italic"
				              VerticalAlignment="Center" Margin="0,0,2,0"
				              Visibility="{Binding YAxisLabel, Converter={StaticResource EmptyToCollapsed}}">
					<q:QTextBlock.LayoutTransform>
						<RotateTransform Angle="-90"/>
					</q:QTextBlock.LayoutTransform>
				</q:QTextBlock>

				<ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Rows}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<ItemsControl ItemsSource="{Binding}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type vm:MatrixCellViewModel}">
									<!-- Bunka + oddelovaci linky: osa X ma pod sebou vodorovnou linku,
									     osa Y vpravo svislou, obe s mezerou (linka lezi presne mezi osou
									     a daty); zaporne okraje -1 premostuji 1px mezery mezi bunkami,
									     aby linka byla souvisla. Roh mapy (placeholder) nese obe. -->
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="*"/>
											<RowDefinition Height="Auto"/>
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<Border x:Name="CellBorder" Grid.Row="0" Grid.Column="0" Margin="1"
										        BorderThickness="0.6" BorderBrush="#55808080"
										        Width="{Binding DataContext.CellWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
											<Grid>
												<!-- Zadny lokalni Style: prebil by implicitni theme styl QText* prvku
												     registrovany v ShellWindow.Resources (barvy tematu).
												     Display je read-only QTextBox jako u SignalControlu: QTextBlock
												     (potomek TextBlocku) by uvnitr DataTemplate implicitni styl
												     z ShellWindow nedostal a text by nemel barvy tematu.
												     Red after a failed on-request read (same as the Read button). -->
												<q:QTextBox x:Name="DisplayText" Text="{Binding Text, Mode=OneWay}" TextAlignment="Right"
												            IsReadOnly="True"
												            Background="{Binding DataContext.IsReadError,
												                         RelativeSource={RelativeSource AncestorType=UserControl},
												                         Converter={StaticResource ErrorBackground}}"
												            Visibility="{Binding DataContext.IsWriteActive,
												                         RelativeSource={RelativeSource AncestorType=UserControl},
												                         Converter={StaticResource TrueToCollapsed}}"/>
												<!-- Edit cell: orange in write mode (editable, whatever Write on Enter), yellow
												     while the edited value is pending, red after a failed write -->
												<q:QTextBox x:Name="EditText" Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												            TextAlignment="Right"
												            Visibility="{Binding DataContext.IsWriteActive,
												                         RelativeSource={RelativeSource AncestorType=UserControl},
												                         Converter={StaticResource TrueToVisible}}"
												            ToolTip="Engineering value; Enter writes it (Write on Enter) or the Write button sends it">
													<q:QTextBox.Background>
														<MultiBinding Converter="{StaticResource EditStateBackground}">
															<Binding Path="DataContext.IsWriteActive" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
															<Binding Path="IsDirty"/>
															<Binding Path="IsWriteError"/>
														</MultiBinding>
													</q:QTextBox.Background>
													<q:QTextBox.InputBindings>
														<KeyBinding Key="Enter" Command="{Binding CommitCommand}"/>
													</q:QTextBox.InputBindings>
												</q:QTextBox>
											</Grid>
										</Border>

										<Rectangle x:Name="BottomLine" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
										           Height="1" Margin="-1,3,-1,3" Fill="#FF909090" Visibility="Collapsed"/>
										<Rectangle x:Name="RightLine" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
										           Width="1" Margin="3,-1,3,-1" Fill="#FF909090" Visibility="Collapsed"/>
									</Grid>
									<DataTemplate.Triggers>
										<!-- Osy se od dat lisi jen oddelovaci linkou (tucne pismo vyrazeno
										     jako nadbytecne - rozhodnuti Radka 2026-07-17) -->
										<DataTrigger Binding="{Binding Kind}" Value="XAxis">
											<Setter TargetName="BottomLine" Property="Visibility" Value="Visible"/>
										</DataTrigger>
										<DataTrigger Binding="{Binding Kind}" Value="YAxis">
											<Setter TargetName="RightLine" Property="Visibility" Value="Visible"/>
										</DataTrigger>
										<DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
											<Setter TargetName="DisplayText" Property="Visibility" Value="Hidden"/>
											<Setter TargetName="EditText" Property="Visibility" Value="Hidden"/>
											<Setter TargetName="CellBorder" Property="BorderThickness" Value="0"/>
											<Setter TargetName="BottomLine" Property="Visibility" Value="Visible"/>
											<Setter TargetName="RightLine" Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</DataTemplate.Triggers>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
		</Grid>
	</Grid>
</UserControl>
