\pard\sa120\sl252\slmult1\qj\b0\f0\fs22 14.2 Ve\u353?ker\u233? spory vznikl\u233? z t\u233?to Smlouvy nebo v souvislosti s n\u237? budou p\u345?edlo\u382?eny soud\u367?m \u268?esk\u233? republiky p\u345?\u237?slu\u353?n\u253?m podle s\u237?dla QENEX. T\u237?m nen\u237? spot\u345?ebitel\u367?m od\u328?ata ochrana, kterou jim poskytuj\u237? kogentn\u237? ustanoven\u237? pr\u225?va zem\u283? jejich bydli\u353?t\u283?.\par
\pard\sb200\sa120\sl252\slmult1\ql\keepn\b\f0\fs22 15. OBECN\u193? USTANOVEN\u205?\par
\pard\sa120\sl252\slmult1\qj\b0\f0\fs22 15.1 \u218?plnost smlouvy. Tato Smlouva spolu s parametry licence vydan\u253?mi Licen\u269?n\u237? slu\u382?bou nebo uveden\u253?mi v potvrzen\u237? objedn\u225?vky QENEX a s licen\u269?n\u237?mi podm\u237?nkami t\u345?et\u237?ch stran uveden\u253?mi v \u269?l\u225?nku 6 tvo\u345?\u237? \u250?plnou dohodu stran t\u253?kaj\u237?c\u237? se Softwaru a nahrazuje v\u353?echny p\u345?edchoz\u237? nebo sou\u269?asn\u233? n\u225?vrhy, dohody a sd\u283?len\u237?. Podm\u237?nky obsa\u382?en\u233? ve va\u353?ich objedn\u225?vk\u225?ch nebo jin\u253?ch dokumentech se odm\u237?taj\u237? a nemaj\u237? \u382?\u225?dn\u253? \u250?\u269?inek.\par
