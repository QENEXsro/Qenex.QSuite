<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latestmajor</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Qenex.QSuite.ModuleXmlHandler</AssemblyName>
        <RootNamespace>Qenex.QSuite.ModuleXmlHandler</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Qenex.QLibs.XmlInOut" Version="1.0.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Common\PluginManager\PluginManager.csproj" />
      <ProjectReference Include="..\..\Drivers\Driver\Driver.csproj" />
      <ProjectReference Include="..\..\LogSystems\LogSystem\LogSystem.csproj" />
      <ProjectReference Include="..\..\Protocols\Protocol\Protocol.csproj" />
      <ProjectReference Include="..\..\Scripting\PythonScript\PythonScript.csproj" />
      <ProjectReference Include="..\Module\Module.csproj" />
      <ProjectReference Include="..\UnifModule\UnifModule.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <EazfuscatorIntegration>MSBuild</EazfuscatorIntegration>
        <EazfuscatorActiveConfigurations>Debug;Release</EazfuscatorActiveConfigurations>
    </PropertyGroup>

    <!-- Eazfuscator.NET: obfuscation as a build step (only when the tool is installed) -->
    <Import Condition="'$(EAZFUSCATOR_NET_HOME)' != '' and Exists('$(EAZFUSCATOR_NET_HOME)\Integration\MSBuild\Eazfuscator.NET.targets')"
            Project="$(EAZFUSCATOR_NET_HOME)\Integration\MSBuild\Eazfuscator.NET.targets" />

</Project>
