<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.0</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Qenex.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Qenex.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <ApplicationIcon>Icons\QInsight.ico</ApplicationIcon>
    <LangVersion>latestmajor</LangVersion>
    <!-- Pouzivame jen anglictinu -> nekopiruj lokalizovane satelitni assembly (slozky cs, de, es, fr, it, ...) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\PythonScriptDark.xshd" />
    <None Remove="Resources\PythonScriptLight.xshd" />
    <EmbeddedResource Include="Resources\PythonScriptDark.xshd" />
    <EmbeddedResource Include="Resources\PythonScriptLight.xshd" />
    <Content Include="Resources\PythonScriptDark.xshd">
      <Link>SyntaxHighlighting\PythonScriptDark.xshd</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\PythonScriptLight.xshd">
      <Link>SyntaxHighlighting\PythonScriptLight.xshd</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

