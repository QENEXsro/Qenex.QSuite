    <!-- Control = sdileny kontrakt (IControlBase/ControlBase), referencuje se primo.
         Konkretni controls (GraphControl, SignalControl, ...) se nacitaji dynamicky jako plugin ze slozky .\Controls, proto bez ProjectReference.
         ScottPlot.WPF je tu jen kvuli zavislostem GraphControlu (vc. nativnich SkiaSharp) - aby zustaly v base dir a plugin si je nasel. -->
    <ProjectReference Include="..\Helpers\ProjectFile\ProjectFile.csproj" />
    <ProjectReference Include="..\LogSystems\LogSystem\LogSystem.csproj" />
    <ProjectReference Include="..\Modules\ModuleXmlHandler\ModuleXmlHandler.csproj" />
