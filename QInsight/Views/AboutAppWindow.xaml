<UserControl x:Class="Qenex.QInsight.Views.AboutAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Qenex.QInsight.Views"
        xmlns:vm="clr-namespace:Qenex.QInsight.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Height="310" Width="650"
        d:DataContext="{d:DesignInstance vm:AboutAppViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="5">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="300" Height="300"
                BorderBrush="{telerik:Windows11Resource ResourceKey=StrokeBrush}" BorderThickness="1">
            <Image Margin="2" Source="/Icons/About.png"/>
        </Border>

        <!-- Text column, exactly as tall as the picture so both share the same top and bottom edge:
             title + tagline at the top, the details block centred in the remaining space, and a footer
             (copyright left, Close right) sitting on the picture's bottom edge. -->
        <Grid Grid.Column="1" Height="300" Margin="20,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <!-- Negative top margin compensates the font's internal leading so the cap height of "QInsight"
                     (not the invisible line box) starts level with the picture's top border. -->
                <TextBlock Text="QInsight" FontSize="48" FontFamily="Segoe UI" FontWeight="Light" Margin="0,-12,0,0"
                           Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Margin="0,4,0,0" FontSize="15" TextAlignment="Center" HorizontalAlignment="Center">
                    <Run Text="Measure, calibrate and analyze"/><LineBreak/>
                    <Run Text="your devices in real time."/>
                </TextBlock>
            </StackPanel>

            <!-- Details block and the copyright line form one centred group in the middle of the column. -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                        </Style>
                    </Grid.Resources>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Margin="0,0,14,8"
                               Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Version}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Company" Margin="0,0,14,8"
                               Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="QENEX s.r.o."/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Web" Margin="0,0,14,8"
                               Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1">
                        <Hyperlink NavigateUri="https://www.qenex.net" RequestNavigate="Hyperlink_RequestNavigate">www.qenex.net</Hyperlink>
                    </TextBlock>
                </Grid>
                <TextBlock Margin="0,12,0,0" FontSize="12" HorizontalAlignment="Center"
                           Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}">
                    <Run Text="{Binding Copyright, Mode=OneWay}"/><Run Text=" QENEX s.r.o. All rights reserved."/>
                </TextBlock>
            </StackPanel>

            <!-- Close alone on the picture's bottom edge. -->
            <Button Grid.Row="2" Content="Close" Width="80" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:InvokeCommandAction Command="{Binding CloseCommand}" PassEventArgsToCommand="True"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </Grid>

    </Grid>
</UserControl>