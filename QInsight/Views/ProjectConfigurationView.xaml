                                            IsReadOnly="{Binding IsReadOnly}"
                                            ToolTip="{Binding Error}"/>
                                        <telerik:RadComboBox
                                            x:Name="ValueComboBox"
                                            Visibility="Collapsed"
                                            ItemsSource="{Binding Options}"
                                            IsEnabled="{Binding IsEditable}"
                                            SelectedItem="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{Binding Error}"/>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                        <Setter TargetName="ValueTextBox" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="ValueComboBox" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid
                Margin="8">
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource ProjectConfigurationPageStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:ProjectConfigurationSection.Scripts}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <telerik:RadButton
                        Height="28"
                        Margin="0,0,6,0"
                        Padding="8,0"
                        Command="{Binding ImportScriptsCommand}"
                        Content="Import"
                        ToolTip="Import scripts from .py files (multiple files can be selected)"/>
                    <telerik:RadButton
                        Height="28"
                        Margin="0,0,6,0"
                        Padding="8,0"
                        Command="{Binding ExportScriptCommand}"
                        Content="Export"
                        ToolTip="Export the selected script as a .py file"/>
                    <telerik:RadButton
                        Height="28"
                        Margin="0,0,12,0"
                        Padding="8,0"
                        Command="{Binding ExportAllScriptsCommand}"
                        Content="Export All"
                        ToolTip="Export all scripts as .py files into a selected folder"/>
                    <telerik:RadButton
                        Width="34"
                        Height="28"
                        Margin="0,0,6,0"
                        Command="{Binding AddScriptCommand}"
                        Content="+"/>
                    <telerik:RadButton
                        Width="34"
                        Height="28"
                        Command="{Binding RemoveScriptCommand}"
                        Content="-"/>
                </StackPanel>

                <telerik:RadGridView
                    Grid.Row="1"
                    ItemsSource="{Binding Scripts}"
                    SelectedItem="{Binding SelectedScript, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    CanUserDeleteRows="False"
                    CanUserInsertRows="False"
                    GroupRenderMode="Flat"
                    RowIndicatorVisibility="Collapsed"
                    ShowGroupPanel="False">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn
                            Width="190"
                            Header="File name"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <q:QTextBox
                                        VerticalAlignment="Center"
                                        Text="{Binding FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="GotKeyboardFocus">
                                                <i:InvokeCommandAction
                                                    Command="{Binding DataContext.SelectScriptCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                    CommandParameter="{Binding}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </q:QTextBox>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="60"
                            Header="Runtime"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="50"
                            Header="Replay"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsReplayEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="150"
                            Header="Execution mode"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <telerik:RadComboBox
                                        ItemsSource="{Binding DataContext.ExecutionModes, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                        SelectedValuePath="Value"
                                        SelectedValue="{Binding ExecutionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="60"
                            Header="Blocking"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding Blocking, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="75"
                            Header="Timeout"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <q:QTextBox
                                        VerticalAlignment="Center"
                                        Text="{Binding TimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="GotKeyboardFocus">
                                                <i:InvokeCommandAction
                                                    Command="{Binding DataContext.SelectScriptCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                    CommandParameter="{Binding}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </q:QTextBox>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="75"
                            Header="Period"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <q:QTextBox
                                        VerticalAlignment="Center"
                                        Text="{Binding PeriodicPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <q:QTextBox.Style>
                                            <Style TargetType="{x:Type q:QTextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPeriodic}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </q:QTextBox.Style>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="GotKeyboardFocus">
                                                <i:InvokeCommandAction
                                                    Command="{Binding DataContext.SelectScriptCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                    CommandParameter="{Binding}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </q:QTextBox>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="70"
                            Header="Unit"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <telerik:RadComboBox
                                        IsEnabled="{Binding IsPeriodic}"
                                        ItemsSource="{Binding PeriodicUnitOptions}"
                                        SelectedValue="{Binding PeriodicUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="*"
                            Header="Parameters"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <q:QTextBox
                                        VerticalAlignment="Center"
                                        Text="{Binding AdditionalInfo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="GotKeyboardFocus">
                                                <i:InvokeCommandAction
                                                    Command="{Binding DataContext.SelectScriptCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                    CommandParameter="{Binding}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </q:QTextBox>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Shared message strip: import/remove results from every section show here. -->
                <q:QTextBlock
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="DarkOrange"
                    TextWrapping="Wrap"
                    Text="{Binding ErrorMessage}">
                    <q:QTextBlock.Style>
                        <Style TargetType="{x:Type q:QTextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </q:QTextBlock.Style>
                </q:QTextBlock>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <telerik:RadButton
                        MinWidth="82"
                        Margin="0,0,8,0"
                        Content="Apply"
                        Command="{Binding ApplyCommand}"/>
                    <telerik:RadButton
                        MinWidth="82"
                        Margin="0,0,8,0"
                        Content="OK"
                        Command="{Binding OkCommand}"/>
                    <telerik:RadButton
                        MinWidth="82"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
