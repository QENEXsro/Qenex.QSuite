<UserControl x:Class="Qenex.QInsight.Views.GeneralPreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:q="clr-namespace:Qenex.QSuite.Controls.OverridenWinControls;assembly=Qenex.QSuite.Controls.OverridenWinControls"
             xmlns:vm="clr-namespace:Qenex.QInsight.ViewModels"
             mc:Ignorable="d"
             MinWidth="600"
             MinHeight="220"
             d:DataContext="{d:DesignInstance vm:GeneralPreferencesViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <Style TargetType="{x:Type q:QTextBox}" BasedOn="{StaticResource {x:Type TextBox}}"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Python is optional: the DLL path applies only while scripts are enabled. -->
        <CheckBox Grid.Row="0"
                  Content="Use Python scripts"
                  IsChecked="{Binding UsePythonScripts, Mode=TwoWay}"/>

        <Grid Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Top" IsEnabled="{Binding UsePythonScripts}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left margin 3 = FocusVisualMargin of the Windows11 CheckBox template, so the label
                 lines up with the check boxes above and below. -->
            <q:QTextBlock Grid.Column="0" Margin="3,0,12,0" VerticalAlignment="Center" Text="Python Dll Path"/>
            <q:QTextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding PythonDllPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <telerik:RadButton Grid.Column="2" MinWidth="72" Margin="0,0,6,0" Content="Browse" Command="{Binding BrowsePythonDllCommand}"/>
            <!-- Detect = registry lookup of an installed 64-bit CPython (PythonInstallationLocator). -->
            <telerik:RadButton Grid.Column="3" MinWidth="72" Content="Detect" Command="{Binding DetectPythonCommand}"
                               ToolTip="Find an installed 64-bit Python (python.org installer) and fill in its DLL path"/>
        </Grid>

        <CheckBox Grid.Row="2"
                  Margin="0,12,0,0"
                  Content="Show debug messages in the log"
                  IsChecked="{Binding ShowDebugLogMessages, Mode=TwoWay}"/>

        <q:QTextBlock Grid.Row="3"
                      Margin="0,8,0,0"
                      Foreground="Tomato"
                      Text="{Binding ErrorMessage}"
                      TextWrapping="Wrap">
            <q:QTextBlock.Style>
                <Style TargetType="{x:Type q:QTextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </q:QTextBlock.Style>
        </q:QTextBlock>

        <q:QTextBlock Grid.Row="4"
                      Margin="0,8,0,0"
                      Text="{Binding InfoMessage}"
                      TextWrapping="Wrap">
            <q:QTextBlock.Style>
                <Style TargetType="{x:Type q:QTextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasInfo}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </q:QTextBlock.Style>
        </q:QTextBlock>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <telerik:RadButton MinWidth="80" Margin="0,0,8,0" Content="Apply" Command="{Binding ApplyCommand}"/>
            <telerik:RadButton MinWidth="80" Margin="0,0,8,0" Content="OK" Command="{Binding OkCommand}"/>
            <telerik:RadButton MinWidth="80" Content="Cancel" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
