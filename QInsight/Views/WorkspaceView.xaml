<UserControl x:Class="Qenex.QInsight.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:primitives="clr-namespace:Telerik.Windows.Controls.Diagrams.Primitives;assembly=Telerik.Windows.Controls.Diagrams"
             xmlns:vm="clr-namespace:Qenex.QInsight.ViewModels"
             xmlns:local="clr-namespace:Qenex.QInsight.Views"
             xmlns:dragdrop="clr-namespace:Qenex.QInsight.DragDrop"
             xmlns:behaviors="clr-namespace:Qenex.QInsight.Behaviors"
             d:DataContext="{d:DesignInstance vm:WorkspaceViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             x:Name="WorkspaceUserControl">

	<!-- primitives:BackgroundGrid.CellSize="{Binding GridCellSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" -->
    <telerik:RadDiagram
        Name="RadDiagram"
        IsZoomEnabled="False"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        primitives:BackgroundGrid.IsDynamic="True"
        IsSnapToGridEnabled="{Binding IsSnapToGridEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Background="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        primitives:BackgroundGrid.IsGridVisible="{Binding IsGridVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        primitives:BackgroundGrid.LineStroke="{Binding GridLineColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        primitives:BackgroundPageGrid.IsGridVisible="{Binding IsPageGridVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

		<i:Interaction.Behaviors>
			<dragdrop:WorkspaceDragAndDropBehavior/>
			<behaviors:DiagramClipboardGuardBehavior/>
			<behaviors:DiagramMouseWheelScrollBehavior/>
		</i:Interaction.Behaviors>
	</telerik:RadDiagram>
    
    <i:Interaction.Triggers>
		<i:EventTrigger EventName="Loaded">
			<i:InvokeCommandAction Command="{Binding WorkspaceViewLoadedCommand}" 
                                   CommandParameter="{Binding ElementName=RadDiagram}"/>
		</i:EventTrigger>
	</i:Interaction.Triggers>
</UserControl>
 